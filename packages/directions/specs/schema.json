{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fitting Room direction spec",
  "description": "One design direction for a Fitting Room board slot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "id", "name", "description", "surfaces"],
  "properties": {
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "id": {
      "type": "string",
      "enum": ["refined", "native", "bold", "wildcard"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "marketing",
          "authentication",
          "onboarding",
          "dashboard",
          "app-screens",
          "settings",
          "checkout"
        ]
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["light", "deep"]
      }
    }
  }
}
