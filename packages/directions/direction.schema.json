{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fitting Room design direction",
  "description": "One named design direction from the Fitting Room direction library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "surfaces",
    "description",
    "bestFor",
    "typePair",
    "typeScale",
    "radius",
    "border",
    "shadow",
    "colorRecipe",
    "density",
    "motion",
    "layoutRules",
    "do",
    "dont",
    "a11yRisk"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["marketing", "app", "dashboard"]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "bestFor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "typePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "body"],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typeScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "ratio", "steps"],
      "properties": {
        "base": {
          "type": "number",
          "minimum": 12
        },
        "ratio": {
          "type": "number",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 10
          }
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "panel"],
      "properties": {
        "control": {
          "type": "string",
          "minLength": 1
        },
        "panel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "border": {
      "type": "string",
      "minLength": 1
    },
    "shadow": {
      "type": "string",
      "minLength": 1
    },
    "colorRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "mutedText",
        "accent",
        "accentText",
        "border",
        "focus",
        "contrastPairs"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "mutedText": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentText": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "focus": {
          "$ref": "#/$defs/color"
        },
        "contrastPairs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foreground", "background", "ratio", "usage"],
            "properties": {
              "foreground": {
                "$ref": "#/$defs/color"
              },
              "background": {
                "$ref": "#/$defs/color"
              },
              "ratio": {
                "type": "number",
                "minimum": 4.5
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "density": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "motion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "layoutRules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "do": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dont": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "a11yRisk": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
