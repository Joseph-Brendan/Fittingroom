{
  "name": "@fitroom/core",
  "version": "0.0.0",
  "description": "Capture, audit, detect, and diff UI for Fitroom.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external @fitroom/directions",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fitroom/directions": "workspace:*",
    "axe-core": "^4.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph-Brendan/fitroom.git"
  },
  "homepage": "https://github.com/Joseph-Brendan/fitroom",
  "bugs": {
    "url": "https://github.com/Joseph-Brendan/fitroom/issues"
  }
}
