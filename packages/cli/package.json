{
  "name": "@fittingroom/cli",
  "version": "0.0.0",
  "description": "The fitroom command for Fitting Room.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "fitroom": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external @fittingroom/core --external @fittingroom/directions",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fittingroom/core": "workspace:*",
    "@fittingroom/board": "workspace:*",
    "vite": "^7.3.7",
    "ws": "^8.22.0",
    "@fittingroom/directions": "workspace:*"
  }
}
