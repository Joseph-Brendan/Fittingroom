{
  "name": "fitting-room",
  "version": "0.0.0",
  "private": true,
  "description": "Try your UI on before you ship it.",
  "license": "Apache-2.0",
  "author": "Joseph Brendan",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "tsx": "^4.23.15",
    "@types/ws": "^8.18.2"
  }
}
